# Cloudflare Pages: 정적 파일 캐시 설정 (Functions 응답에는 적용되지 않는다)

# 빌드할 때마다 파일 이름이 바뀌는 JS·CSS → 1년, 다시 확인하지 않음
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 폰트 (파일 이름이 바뀌면 새로 받는다)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# 아이콘·샘플 이미지
/icon-*.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/favicon*
  Cache-Control: public, max-age=86400
/samples/*
  Cache-Control: public, max-age=86400

# 관리자 화면은 검색에 나오지 않게 한다 (robots.txt 로도 막고, 화면에도 noindex 가 들어 있다)
/admin*
  X-Robots-Tag: noindex, nofollow

# 공유 미리보기 기본 이미지
/og-default.png
  Cache-Control: public, max-age=86400
/icon-maskable-*.png
  Cache-Control: public, max-age=86400
